MEDIEXPLAIN_ENVIRONMENT=development
MEDIEXPLAIN_DATABASE_URL=postgresql+psycopg://mediexplain:local-development-only@localhost:5432/mediexplain
MEDIEXPLAIN_SECRET_KEY=replace-with-at-least-32-random-characters
MEDIEXPLAIN_ALLOWED_ORIGINS=["http://localhost:3000"]
MEDIEXPLAIN_LOG_LEVEL=INFO
MEDIEXPLAIN_ACCESS_TOKEN_MINUTES=15
MEDIEXPLAIN_REFRESH_TOKEN_DAYS=30
MEDIEXPLAIN_PASSWORD_RESET_MINUTES=30
# Docker Compose supplies Mailpit automatically; configure these for service-only use.
MEDIEXPLAIN_SMTP_HOST=localhost
MEDIEXPLAIN_SMTP_PORT=1025
MEDIEXPLAIN_SMTP_SECURITY=none
# Production: use starttls or ssl and inject credentials from a secret manager.
# MEDIEXPLAIN_SMTP_USERNAME=your-smtp-user
# MEDIEXPLAIN_SMTP_PASSWORD=your-smtp-password
MEDIEXPLAIN_SMTP_SENDER=noreply@example.com
MEDIEXPLAIN_RATE_LIMIT_PER_MINUTE=100
MEDIEXPLAIN_PROVIDER_TIMEOUT_SECONDS=8
MEDIEXPLAIN_PROVIDER_RETRY_COUNT=1
MEDIEXPLAIN_RXNORM_ENABLED=true
MEDIEXPLAIN_MEDLINEPLUS_ENABLED=true
MEDIEXPLAIN_DAILYMED_ENABLED=true
MEDIEXPLAIN_DRAP_DATASET_ENABLED=true
MEDIEXPLAIN_INTERACTION_PROVIDER=not_configured
MEDIEXPLAIN_AI_PROVIDER=gemini_ollama
MEDIEXPLAIN_AI_TIMEOUT_SECONDS=60
# Server only. This same file is read by docker-compose.ai.yml; never put the key in Flutter.
MEDIEXPLAIN_GEMINI_API_KEY=
# Verified primary and secondary models; emergency slots remain empty.
MEDIEXPLAIN_GEMINI_MODEL=gemini-3.5-flash-lite
MEDIEXPLAIN_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
MEDIEXPLAIN_GEMINI_EMERGENCY_MODEL=
MEDIEXPLAIN_GEMINI_PRESCRIPTION_MODEL=gemini-3.5-flash-lite
MEDIEXPLAIN_GEMINI_PRESCRIPTION_FALLBACK_MODEL=gemini-3.1-flash-lite
MEDIEXPLAIN_GEMINI_PRESCRIPTION_EMERGENCY_MODEL=
MEDIEXPLAIN_GEMINI_HANDWRITING_MODEL=gemini-3.5-flash-lite
MEDIEXPLAIN_GEMINI_HANDWRITING_FALLBACK_MODEL=gemini-3.1-flash-lite
MEDIEXPLAIN_GEMINI_HANDWRITING_EMERGENCY_MODEL=
MEDIEXPLAIN_GEMINI_TIMEOUT_SECONDS=20
MEDIEXPLAIN_GEMINI_COOLDOWN_SECONDS=300
# Optional second cloud provider: Gemini -> Groq -> Ollama (text explanations only).
# Image reading/structuring use Gemini -> Groq, never local text-only Ollama.
MEDIEXPLAIN_GROQ_API_KEY=
MEDIEXPLAIN_GROQ_MODEL=openai/gpt-oss-120b
MEDIEXPLAIN_GROQ_VISION_MODEL=qwen/qwen3.8-27b
MEDIEXPLAIN_GROQ_TIMEOUT_SECONDS=20
MEDIEXPLAIN_GROQ_COOLDOWN_SECONDS=300
MEDIEXPLAIN_GROQ_MAX_OUTPUT_TOKENS=2048
# One batch response may contain up to 40 medicine summaries.
MEDIEXPLAIN_GROQ_BATCH_MAX_OUTPUT_TOKENS=8192
MEDIEXPLAIN_GROQ_VISION_MAX_OUTPUT_TOKENS=768
MEDIEXPLAIN_GROQ_VISION_MAX_IMAGES=3
MEDIEXPLAIN_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEDIEXPLAIN_OLLAMA_MODEL=qwen3:1.7b
# MEDIEXPLAIN_AI_BASE_URL=https://provider.example
# MEDIEXPLAIN_AI_API_KEY=use-a-secret-manager
# MEDIEXPLAIN_AI_MODEL=configured-model-name
MEDIEXPLAIN_ADMIN_SESSION_MINUTES=30
MEDIEXPLAIN_ADMIN_INACTIVITY_MINUTES=15
MEDIEXPLAIN_ADMIN_MFA_REQUIRED=false
MEDIEXPLAIN_MAX_IMPORT_BYTES=5000000
MEDIEXPLAIN_TEMPORARY_SCAN_RETENTION_HOURS=24
MEDIEXPLAIN_AI_CONVERSATION_RETENTION_DAYS=30
MEDIEXPLAIN_EXPORT_RETENTION_HOURS=24
MEDIEXPLAIN_PROVIDER_CACHE_RETENTION_DAYS=90

# Re-read doubtful handwriting with a bounded second cloud request (no local model).
MEDIEXPLAIN_GEMINI_HANDWRITING_RECHECK=true

# Optional development LAN identity. Generate once with scripts/prepare_local_server_identity.py.
# MEDIEXPLAIN_LOCAL_SERVER_PRIVATE_KEY=<generated P-256 private value; server only>


# gemini-2.5-flash-lite returned 404 in live checks on 2026-10-22.
# Enable an emergency slot only after successful text/image verification.
# Unknown/global quota scopes pause Gemini across all workflows.

# Development only; production rejects single-admin self-review.
MEDIEXPLAIN_ADMIN_ALLOW_LOCAL_SELF_REVIEW=false
